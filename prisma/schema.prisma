generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                String         @id @default(uuid())
  slug              String         @unique
  name              String
  shortDescription  String?
  description       String
  price             Int
  compareAtPrice    Int?
  sku               String?
  stock             Int            @default(0)
  featured          Boolean        @default(false)
  active            Boolean        @default(true)
  weightGrams       Int            @default(300)
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SiteSection {
  id       String  @id @default(uuid())
  key      String  @unique
  title    String?
  subtitle String?
  imageUrl String?
  linkUrl  String?
  linkText String?
}

// Bloques de contenido repetibles de la home, agrupados por "group":
// "benefit" (barra de beneficios), "process" (cómo funciona tu pedido) y
// "testimonial" (reseñas). Un solo modelo flexible en vez de una tabla por
// sección, editable desde /admin/contenido.
model ContentItem {
  id        String   @id @default(uuid())
  group     String
  icon      String?
  title     String
  subtitle  String?
  body      String?
  rating    Int?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([group, position])
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Tarifas de envío personalizadas por departamento/municipio, para anular
// las tarifas de referencia por defecto (útil para marcar zonas más caras
// o para fijar el precio del mensajero local en la ciudad de la tienda).
// city = "" significa "tarifa por defecto de todo el departamento".
model ShippingRate {
  id         String   @id @default(uuid())
  department String
  city       String   @default("")
  cost       Int
  etaLabel   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([department, city])
}

model Order {
  id            String   @id @default(uuid())
  code          String   @unique
  customerName  String
  phone         String
  email         String?
  address       String
  department    String
  city          String
  notes         String?
  itemsJson     String
  subtotal      Int
  shippingCost  Int
  total         Int
  status        String   @default("pendiente")
  // Estado real del cobro en Wompi: pendiente | aprobado | declinado | error | anulado
  paymentStatus String   @default("pendiente")
  paymentMethod String?
  wompiReference   String? @unique
  wompiTransactionId String? @unique
  createdAt     DateTime @default(now())
}

// Suscripciones de notificaciones push del navegador (panel administrativo)
// para avisar sonido + notificación cuando entra un pago aprobado.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
